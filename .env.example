# Copy to .env (never commit .env). Defaults run everything locally with no credentials.
# --- Modes ---
AUTH_MODE=databricks
DATA_BACKEND=databricks
PIPELINE=live
LLM_MODE=databricks
CHAT_MODE=agent                # switch to genie only after a Genie space exists
CONFIDENCE_THRESHOLD=0.825     # auto-release threshold chosen by the confidence model
MOCK_DELAY_SECONDS=2.5
DATA_DIR=
SESSION_SECRET=<RANDOM_STRING>
DEVICE_TOKEN=<RANDOM_STRING>

# --- Databricks ---
DATABRICKS_HOST=https://dbc-45c9154d-c76b.cloud.databricks.com
DATABRICKS_TOKEN=<YOUR_PERSONAL_ACCESS_TOKEN>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/6e4f969ac71d3b26
UC_CATALOG=infrared
UC_SCHEMA=shpe
LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
GENIE_SPACE_ID=
MLFLOW_TRACKING_URI=databricks
CONFIDENCE_MODEL_URI=          # leave empty unless the app sends the 6 agent features (see section 5)
```
