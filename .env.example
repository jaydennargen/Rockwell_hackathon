# Copy to .env (never commit .env). Defaults run everything locally with no credentials.
AUTH_MODE=demo                 # demo | databricks
DATA_BACKEND=local             # memory | local | databricks
PIPELINE=mock                  # mock | live
LLM_MODE=fake                  # fake | databricks
CHAT_MODE=fake                 # fake | agent | genie
CONFIDENCE_THRESHOLD=0.70
MOCK_DELAY_SECONDS=2.5
DATA_DIR=                      # default backend/.data (app.db, gold.db)
SESSION_SECRET=change-me
DEVICE_TOKEN=change-me

# databricks modes only
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
UC_CATALOG=hackathon
UC_SCHEMA=triage
LLM_ENDPOINT=
GENIE_SPACE_ID=
MLFLOW_TRACKING_URI=           # set (e.g. databricks) to trace pipeline steps
CONFIDENCE_MODEL_URI=          # optional MLflow model; unset = hand-weighted scoring
