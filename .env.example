# Copy to .env (never commit .env). Defaults run everything locally with no credentials.
AUTH_MODE=demo                 # demo | databricks
DATA_BACKEND=memory            # memory | local | databricks
PIPELINE=mock                  # mock | live
LLM_MODE=fake                  # fake | databricks
CHAT_MODE=fake                 # fake | agent | genie
CONFIDENCE_THRESHOLD=0.70
MOCK_DELAY_SECONDS=2.5
SESSION_SECRET=change-me
DEVICE_TOKEN=change-me

# databricks modes only
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
UC_CATALOG=hackathon
UC_SCHEMA=triage
LLM_ENDPOINT=
GENIE_SPACE_ID=
