# Copy to .env in the repo root for LOCAL runs (never commit .env; it is never deployed).
# Inside Databricks Apps these come from app.yaml instead, and credentials are injected automatically.

# ---------------------------------------------------------------------------------------------
# 1. Modes. All-local defaults need no Databricks access at all.
# ---------------------------------------------------------------------------------------------
AUTH_MODE=demo                 # demo locally (role picker). databricks = SSO identity; only behind Databricks Apps
DATA_BACKEND=local             # local (SQLite) | databricks (Delta via SQL warehouse) | memory (tests)
PIPELINE=mock                  # mock | live
LLM_MODE=fake                  # fake | databricks
CHAT_MODE=fake                 # fake | agent | genie (genie only after a Genie space exists)
CONFIDENCE_THRESHOLD=0.825     # auto-release threshold chosen by the confidence model
MOCK_DELAY_SECONDS=2.5
DATA_DIR=                      # default backend/.data (app.db, gold.db)
SESSION_SECRET=<RANDOM_STRING> # demo login cookie signing
DEVICE_TOKEN=<RANDOM_STRING>   # bench device (hardware/); empty = device endpoint off
SPECIALIST_EMAILS=             # AUTH_MODE=databricks: comma-separated emails that get the specialist view

# ---------------------------------------------------------------------------------------------
# 2. Databricks (only for DATA_BACKEND / LLM_MODE / CHAT_MODE = databricks modes)
#    Auth uses Databricks unified authentication. Preferred: OAuth via a CLI profile:
#        databricks auth login --host https://dbc-45c9154d-c76b.cloud.databricks.com --profile mate
#    then set DATABRICKS_CONFIG_PROFILE=mate. No token needed in this file.
# ---------------------------------------------------------------------------------------------
DATABRICKS_CONFIG_PROFILE=     # e.g. mate (from ~/.databrickscfg)
DATABRICKS_HOST=https://dbc-45c9154d-c76b.cloud.databricks.com
# DATABRICKS_TOKEN=            # fallback only (personal access token); don't set together with a profile
DATABRICKS_WAREHOUSE_ID=6e4f969ac71d3b26
DATABRICKS_HTTP_PATH=          # alternative to the warehouse id: /sql/1.0/warehouses/<id>
UC_CATALOG=infrared
UC_SCHEMA=shpe
LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
GENIE_SPACE_ID=
MLFLOW_TRACKING_URI=           # databricks = trace pipeline steps to MLflow
CONFIDENCE_MODEL_URI=          # leave empty unless the app sends the 6 agent features

# ---------------------------------------------------------------------------------------------
# 3. Set automatically by Databricks Apps. Do NOT set these yourself:
#    DATABRICKS_APP_NAME, DATABRICKS_APP_PORT, DATABRICKS_HOST, DATABRICKS_WORKSPACE_ID,
#    DATABRICKS_CLIENT_ID, DATABRICKS_CLIENT_SECRET (the app's service principal, OAuth M2M)
# ---------------------------------------------------------------------------------------------
